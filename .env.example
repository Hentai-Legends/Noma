# Gemini API Configuration
# Masukkan satu atau beberapa API key (pisahkan dengan koma jika lebih dari satu untuk fitur Round-Robin Auto-Switch)
GEMINI_API_KEY=your_gemini_api_key_here

# Default Model Selection (e.g., gemini-2.5-flash, gemini-2.0-flash, gemini-3.0-flash)
GEMINI_MODEL=gemini-2.5-flash

# Chunk Configuration (max words per chunk)
MAX_WORDS_PER_CHUNK=2000
